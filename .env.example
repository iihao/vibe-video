PORT=3000
# 无密钥时使用内置且可编辑的引力时间膨胀示例。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_PROVIDER=deepseek
AI_PROTOCOL=chat
# 推荐在网页「接入大模型」中配置、测试并启用，无需重启。
# 网页保存的配置优先于上述初始配置。
# VIBE_DATA_DIR=/absolute/path/to/data
# 留空时自动尝试本机 Chrome，再尝试 Playwright Chromium。
CHROME_EXECUTABLE=
FFMPEG_PATH=ffmpeg
